{
  "name": "yerdema-subs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Real-time English to Turkish subtitle translation for YouTube and HTML5 videos (Chrome/Edge MV3).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs && node scripts/verify-dist.mjs",
    "package": "npm run build && node scripts/zip.mjs",
    "icons": "node scripts/icons.mjs",
    "serve:test": "node scripts/serve.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.4",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
